:80 {
	# 기본 설치는 평문 http(LAN)라 HSTS는 넣지 않는다 — HTTPS 프록시를 앞에 둘 때 거기서 켠다.
	# CSP는 Next의 인라인 부트스트랩 스크립트 때문에 nonce 배선이 필요해 별도 작업으로 둔다.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# 카메라는 현재 어디서도 쓰지 않는다 — 바코드 스캐너가 돌아오면 camera=(self)로 연다.
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# api의 헬스체크 라우트는 /api 프리픽스가 없어서 별도로 연결해준다.
	handle /health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

# 기본 설치는 오리진 루트. BASE_PATH=/kibble 처럼 서브패스에 붙이면 웹 클라이언트가
# /kibble/api/... 를 치므로, 프록시가 그 요청에서 /kibble 만 벗긴 뒤 API로 넘기고,
# 웹(Next) 요청은 프리픽스를 그대로 남겨야 한다. 아래를 루트 handle 대신 쓴다.
#
# handle /kibble/api* {
# 	uri strip_prefix /kibble
# 	reverse_proxy api:8080
# }
# handle /kibble* {
# 	reverse_proxy web:3000
# }
