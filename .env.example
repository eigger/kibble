# kibble — 로컬/Compose 환경 변수 예시
# cp .env.example .env 후 값을 채운다.
# 배포 전체 절차: docs/deploy.md

# --- PostgreSQL ---
POSTGRES_USER=kibble
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kibble
POSTGRES_PORT=5433

# --- API ---
# openssl rand -hex 32 로 생성. 아래 값은 로컬 개발용 예시뿐이다.
# docker-compose.yml 은 NODE_ENV=development 이므로 dev-secret-change-me 도 허용된다.
# docker-compose.prod.yml (NODE_ENV=production) 에서는 changeme / dev-secret-change-me / 빈 값이 거부된다.
JWT_SECRET=dev-secret-change-me

# 청크 업로드 총 파일 상한 (MB). 기본 500. multipart 단건은 20MB.
# FILE_SIZE_LIMIT_MB=500

# 브라우저가 접속하는 공개 URL (미디어 쿠키·절대 링크). Compose 로컬: http://localhost
APP_PUBLIC_URL=http://localhost

# http 기본 설치에서는 false. HTTPS 프록시 뒤에서만 true.
COOKIE_SECURE=false

# 웹 앱을 오리진 루트가 아닌 서브패스에 붙일 때만 설정한다 (예: BASE_PATH=/kibble).
# 도커 이미지는 플레이스홀더로 빌드되고 기동 시 이 값으로 치환된다 — Home Assistant
# Ingress처럼 설치본마다 경로가 다른 배포를 같은 이미지로 커버하기 위한 장치다.
# 비워두면 지금까지처럼 루트에 붙는다.
# 서브패스에서는 프록시도 맞춰야 한다: 웹은 {BASE_PATH}/api/... 를 치므로, 그 요청에서
# 프리픽스만 벗긴 뒤 API로 넘긴다. 기본 Caddyfile은 루트의 /api 만 연결한다.
# 서브패스용 프록시 예시는 docs/deploy.md 를 본다.
BASE_PATH=

# 프로덕션(NODE_ENV=production)에서 브라우저 CORS는 APP_PUBLIC_URL 오리진만 허용한다.
# 웹과 API를 서로 다른 호스트에 두거나 접속 도메인이 여럿이면 여기에 쉼표로 나열한다.
# 로컬 dev는 모든 오리진을 반사하므로 설정할 필요가 없다.
# CORS_EXTRA_ORIGINS=https://kibble.example.com,http://192.168.0.10

# --- docker-compose.prod.yml (GHCR 이미지) ---
GH_REPOSITORY_OWNER=eigger

# --- 시드 관리자 (선택, CLI 전용) ---
# 평소에는 설정하지 않는다. 첫 관리자는 브라우저 로그인 화면에서 만든다 —
# 계정이 하나도 없을 때만 열리는 경로다.
# ADMIN_PASSWORD 를 준 경우에만 `prisma db seed` 가 관리자를 생성한다.
# (기본값을 두면 모든 신규 설치가 공개된 비밀번호의 관리자를 갖고 뜨고,
#  로그인 화면의 최초 관리자 생성 분기가 영영 열리지 않는다.)
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=관리자

# --- 개발 전용 (프로덕션 금지) ---
# web:3000 → api:8080 교차 오리진에서만
# MEDIA_AUTH_DISABLED=true

# --- 푸시 알림 (선택) ---
# DB Setting 또는 관리자 설정 화면에서 VAPID 키를 발급할 수도 있다.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
