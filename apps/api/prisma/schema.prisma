generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  GENERAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(GENERAL)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
